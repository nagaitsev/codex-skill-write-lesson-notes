{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -ExecutionPolicy Bypass -File ./scripts/update-plugin.ps1 -Quiet",
            "timeoutSec": 20,
            "statusMessage": "Checking write-lesson-notes updates"
          }
        ]
      }
    ]
  }
}
